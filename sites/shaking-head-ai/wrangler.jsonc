{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shaking-head-ai",
  "account_id": "80797548dfa9244ddcd458f0375525ae",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "shakingheadai.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "BILLING_ENABLED": "0",
    "EMAIL_LOGIN_ENABLED": "0",
    "EMAIL_FROM": "noreply@shakingheadai.org",
    // To enable Rybbit, set this to your Rybbit API URL (e.g. https://rybbit.example.com/api) and add analytics.rybbit to site.config.ts.
    "RYBBIT_UPSTREAM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaking-head-ai",
      "database_id": "59084a06-f04d-4938-acb1-762c7b0f5437",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "shaking-head-ai-outputs" }],
  "send_email": [{ "name": "EMAIL" }],
  "workflows": [
    {
      "name": "shaking-head-ai-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ]
}
